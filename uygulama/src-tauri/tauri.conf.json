{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dünya Atlası",
  "mainBinaryName": "dunya-atlasi",
  "version": "0.1.0",
  "identifier": "io.github.darvolinnn.dunyaatlasi",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "publisher": "Hakan",
    "shortDescription": "Kurgu evreni atlası",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Turkish"],
        "displayLanguageSelector": false
      }
    }
  }
}
